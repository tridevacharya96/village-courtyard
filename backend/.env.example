# ---------------------------------------------------------------
#  Village Courtyard — environment config
#  Copy this file to `.env` (same folder) and fill in your values.
#  Never commit the real .env to version control.
# ---------------------------------------------------------------

APP_NAME="Village Courtyard"
APP_ENV=local                 # local | production
APP_DEBUG=true                # set false in production
APP_TIMEZONE=Asia/Kolkata

# Where the PHP backend is served from (no trailing slash)
BASE_URL=http://localhost/village-courtyard/backend

# React frontend origin(s) allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=village_courtyard
DB_USER=root
DB_PASS=

# Razorpay (test keys from https://dashboard.razorpay.com/app/keys)
# Values here override the ones saved in Admin → Settings → Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Security
SESSION_NAME=vc_admin
SESSION_LIFETIME=7200         # seconds of inactivity before admin logout
LOGIN_MAX_ATTEMPTS=5          # failed logins allowed…
LOGIN_LOCKOUT_MINUTES=15      # …within this window before lockout
UPLOAD_MAX_MB=5

# Analytics: random string used to anonymise visitor IDs (any long random value)
ANALYTICS_SALT=change-me-to-a-long-random-string
